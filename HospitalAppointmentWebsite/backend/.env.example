# Copy this file to .env and enter your own database credentials.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospital_db
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
# When deployed, set this to your Netlify site origin, e.g. https://your-site.netlify.app
FRONTEND_ORIGIN=http://127.0.0.1:5500
